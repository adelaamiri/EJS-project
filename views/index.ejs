<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home | My EJS Website</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header class="navbar">
      <div class="logo">MyWebsite</div>
      <nav>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <section class="hero">
      <div class="hero-text">
        <h1>Build Your Dream Website</h1>
        <p>
          Welcome to our modern website built with Express.js and EJS. This
          project shows how to create multiple pages and a contact form.
        </p>
        <a href="/about" class="btn">Learn More</a>
      </div>

      <div class="hero-image">
        <img
          src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=900"
          alt="Web Development"
        />
      </div>
    </section>

    <section class="features">
      <h2>Our Features</h2>
      <div class="cards">
        <div class="card">
          <h3>Fast</h3>
          <p>Our website is simple, fast, and easy to use.</p>
        </div>
        <div class="card">
          <h3>Modern</h3>
          <p>Designed like a real website with clean sections and layout.</p>
        </div>
        <div class="card">
          <h3>Responsive</h3>
          <p>Works beautifully on desktop and smaller screens.</p>
        </div>
      </div>
    </section>

    <footer class="footer">
      <p>© 2026 MyWebsite. All rights reserved.</p>
    </footer>
  </body>
</html>
